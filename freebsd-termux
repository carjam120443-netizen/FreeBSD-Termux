#!/data/data/com.termux/files/usr/bin/bash

set -e

PROJECT_DIR="$HOME/.freebsd-termux"
DISK="$PROJECT_DIR/freebsd.img"

mkdir -p "$PROJECT_DIR"

case "${1:-start}" in
  start)
    if ! command -v qemu-system-aarch64 >/dev/null 2>&1; then
      echo "QEMU is not installed. Run: pkg install qemu-system-aarch64-headless"
      exit 1
    fi

    if [ ! -f "$DISK" ]; then
      echo "No FreeBSD disk image found."
      echo "Run: freebsd-termux install"
      exit 1
    fi

    qemu-system-aarch64 \
      -machine virt \
      -cpu max \
      -m 2048 \
      -drive file="$DISK",format=raw,if=virtio \
      -nographic
    ;;
  install)
    echo "FreeBSD ARM64 automatic installation is being prepared."
    echo "The installer will download a compatible FreeBSD image, verify it,"
    echo "and place it at: $DISK"
    echo ""
    echo "Automatic image download is not enabled in this development build yet."
    echo ""
    echo "For now, place a compatible FreeBSD ARM64 raw disk image at:"
    echo "$DISK"
    ;;
  stop)
    echo "FreeBSD-Termux runs in the foreground."
    echo "Press Ctrl-A X in QEMU to exit."
    ;;
  restart)
    exec "$0" start
    ;;
  remove)
    rm -f "$DISK"
    echo "FreeBSD disk image removed."
    ;;
  *)
    echo "Usage: freebsd-termux {install|start|stop|restart|remove}"
    ;;
esac
